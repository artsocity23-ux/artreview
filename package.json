{
  "name": "artreview",
  "productName": "ArtReview",
  "version": "0.1.0",
  "private": true,
  "description": "Art-direction notes on a video shot: numbered pins that follow objects, one button to copy the MP4 with the notes burned in.",
  "author": {
    "name": "artsocity23-ux",
    "email": "263427273+artsocity23-ux@users.noreply.github.com"
  },
  "homepage": "https://github.com/artsocity23-ux/artreview",
  "repository": "github:artsocity23-ux/artreview",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest selftest-out",
    "test": "node test/tracker.test.mjs",
    "test:clipboard": "node test/clipboard.test.js",
    "icon": "node make-icon.js",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "mediabunny": "^1.65.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.artsocity23ux.artreview",
    "productName": "ArtReview",
    "copyright": "© 2026 artsocity23-ux · MIT",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "clipboard.js",
      "selftest.js",
      "index.html",
      "app.css",
      "src/**",
      "donate.html",
      "donate.js",
      "donate.json",
      "icon.png",
      "!test/**",
      "!**/*.map",
      "!**/*.d.ts",
      "!node_modules/mediabunny/src/**",
      "!node_modules/mediabunny/dist/modules/**",
      "!node_modules/mediabunny/dist/bundles/*.cjs",
      "!node_modules/mediabunny/dist/bundles/mediabunny.mjs"
    ],
    "fileAssociations": [
      {
        "ext": "artreview",
        "name": "ArtReview notes",
        "description": "Нотатки ArtReview",
        "role": "Editor"
      }
    ],
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "ArtReview",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "synopsis": "Art-direction notes on video shots, copied to the clipboard as an MP4",
      "maintainer": "artsocity23-ux <263427273+artsocity23-ux@users.noreply.github.com>"
    }
  }
}
